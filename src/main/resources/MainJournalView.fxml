<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.carladumit.digitaljournal.ui.MainJournalController"
            prefWidth="900"
            prefHeight="650"
            stylesheets="@style.css"
            styleClass="main-root">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <top>
        <VBox spacing="4" styleClass="main-header">

            <padding>
                <Insets top="24" right="30" bottom="20" left="30"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="15">

                <VBox spacing="3">
                    <Text text="Digital Journal"
                          styleClass="main-title"/>

                    <Label fx:id="todayLabel"
                           styleClass="today-label"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnNewEntry"
                        text="+  New Entry"
                        onAction="#showNewEntryView"
                        styleClass="button-primary"/>

                <Button text="Sign Out"
                        onAction="#handleSignOut"
                        styleClass="button-secondary"/>
            </HBox>

        </VBox>
    </top>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <center>

        <StackPane>

            <padding>
                <Insets top="0" right="30" bottom="30" left="30"/>
            </padding>

            <VBox fx:id="viewBrowse" spacing="15">

                <HBox spacing="0" styleClass="view-toggle">
                    <ToggleButton fx:id="allEntriesToggle"
                                  text="All Entries"
                                  onAction="#showAllEntriesView"
                                  styleClass="view-toggle-button"/>
                    <ToggleButton fx:id="onThisDayToggle"
                                  text="On This Day"
                                  onAction="#showOnThisDayView"
                                  styleClass="view-toggle-button"/>
                </HBox>

                <StackPane VBox.vgrow="ALWAYS">

                    <!-- ============ ALL ENTRIES VIEW ============ -->
                    <VBox fx:id="viewJournal"
                          spacing="15"
                          visible="true"
                          managed="true">

                        <HBox alignment="CENTER_LEFT">
                            <Label fx:id="entriesCountLabel" styleClass="entries-count-label"/>
                        </HBox>

                        <VBox spacing="15" VBox.vgrow="ALWAYS">
                            <TableView fx:id="entriesTableView" HBox.hgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="dateColumn" text="Date" prefWidth="120"/>
                                    <TableColumn fx:id="moodColumn" text="Mood" prefWidth="100"/>
                                    <TableColumn fx:id="previewColumn" text="Preview" prefWidth="300"/>
                                </columns>
                            </TableView>
                        </VBox>

                        <!-- Selected Entry -->
                        <VBox fx:id="detailPane"
                              spacing="12"
                              styleClass="entry-detail-card"
                              visible="false"
                              managed="false">

                            <HBox alignment="CENTER_LEFT"
                                  spacing="10">

                                <VBox spacing="3">

                                    <Label fx:id="lblSelectedDate"
                                           text="Select an entry"
                                           styleClass="detail-date"/>

                                    <Label fx:id="lblSelectedRating"
                                           styleClass="detail-mood"/>

                                </VBox>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Button fx:id="btnDeleteEntry"
                                        text="Delete Entry"
                                        onAction="#handleDeleteEntry"
                                        styleClass="button-delete"
                                        disable="true"/>

                            </HBox>

                            <Separator/>
                            <TextArea fx:id="txtSelectedContent"
                                      editable="false"
                                      wrapText="true"
                                      VBox.vgrow="ALWAYS"
                                      styleClass="detail-text-area"/>

                            <Label fx:id="historyStatusLabel"
                                   wrapText="true"
                                   styleClass="status-label"/>

                        </VBox>
                        </VBox>


                    <!-- ============ ON THIS DAY VIEW ============ -->
                    <VBox fx:id="viewOnThisDay"
                          spacing="15"
                          visible="false"
                          managed="false">

                        <VBox spacing="4">
                            <Text fx:id="onThisDayTitle" styleClass="section-title"/>
                            <Label fx:id="onThisDaySubtitle" styleClass="today-label"/>
                        </VBox>

                        <VBox spacing="15" VBox.vgrow="ALWAYS">
                            <TableView fx:id="yearlyTableView" HBox.hgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="yearColumn" text="Year" prefWidth="120"/>
                                    <TableColumn fx:id="yearMoodColumn" text="Mood" prefWidth="100"/>
                                    <TableColumn fx:id="yearEntryColumn" text="Entry" prefWidth="300"/>
                                </columns>
                            </TableView>
                        </VBox>

                    </VBox>

                </StackPane>

            </VBox>

            <!-- ============ NEW ENTRY VIEW ============ -->
            <VBox fx:id="viewNewEntry"
                  spacing="15"
                  visible="false"
                  managed="false"
                  styleClass="new-entry-view">

                <padding>
                    <Insets top="30" right="30" bottom="30" left="30"/>
                </padding>

                <Text text="New Entry" styleClass="section-title"/>

                <Label text="How was your day?" styleClass="subtitle"/>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="😄" onAction="#selectRating" userData="GREAT" styleClass="emoji-btn"/>
                    <Button text="🙂" onAction="#selectRating" userData="GOOD" styleClass="emoji-btn"/>
                    <Button text="😐" onAction="#selectRating" userData="NEUTRAL" styleClass="emoji-btn"/>
                    <Button text="🙁" onAction="#selectRating" userData="BAD" styleClass="emoji-btn"/>
                    <Button text="😭" onAction="#selectRating" userData="SAD" styleClass="emoji-btn"/>
                </HBox>

                <Label text="What happened today?" styleClass="subtitle"/>

                <TextArea fx:id="journalTextArea"
                          wrapText="true"
                          promptText="Write about your day..."
                          VBox.vgrow="ALWAYS"
                          styleClass="text-area"/>

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Label fx:id="statusLabel" styleClass="status-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Cancel" onAction="#showJournalView" styleClass="button-secondary"/>
                    <Button text="Save Entry" onAction="#handleSaveEntry" styleClass="button-primary"/>
                </HBox>

            </VBox>

        </StackPane>

    </center>

</BorderPane>